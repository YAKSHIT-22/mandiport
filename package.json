{
  "name": "mandiport",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "discover-fields": "tsx --env-file-if-exists=.env.local scripts/discover-fields.ts",
    "pull-day": "tsx --env-file-if-exists=.env.local scripts/pull-day.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:migrate:test": "tsx --env-file-if-exists=.env.local scripts/migrate.ts --test",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "ingest:mandi": "tsx --env-file-if-exists=.env.local scripts/ingest-mandi.ts",
    "ingest:backfill": "tsx --env-file-if-exists=.env.local scripts/ingest-mandi.ts --source=variety",
    "ingest:msp": "tsx --env-file-if-exists=.env.local scripts/ingest-msp.ts",
    "ingest:exports": "tsx --env-file-if-exists=.env.local scripts/ingest-exports.ts",
    "rollups": "tsx --env-file-if-exists=.env.local scripts/build-rollups.ts",
    "tiers": "tsx --env-file-if-exists=.env.local scripts/calculate-tiers.ts",
    "mappings:suggest": "tsx --env-file-if-exists=.env.local scripts/suggest-export-mappings.ts",
    "briefs:generate": "tsx --env-file-if-exists=.env.local scripts/generate-ai-briefs.ts",
    "alerts:send": "tsx --env-file-if-exists=.env.local scripts/send-alerts.ts",
    "geocode:markets": "tsx --env-file-if-exists=.env.local scripts/geocode-markets.ts",
    "telegram:webhook": "tsx --env-file-if-exists=.env.local scripts/setup-telegram-webhook.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.5",
    "@types/mdx": "^2.0.14",
    "@upstash/redis": "^1.38.4",
    "ai": "^7.0.105",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "^6.2.1",
    "tailwind-merge": "^3.7.0",
    "undici": "7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4",
    "@axe-core/playwright": "^4.13.0",
    "@next/env": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0"
    }
  }
}
