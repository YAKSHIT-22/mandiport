# Database (Neon pooled connection string in production; local Postgres for development)
DATABASE_URL=
DATABASE_URL_TEST=                       # separate database for integration tests

# Cache: Upstash REST in production, or REDIS_URL for a local Redis server
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# data.gov.in
DATAGOVIN_API_KEY=
DATAGOVIN_RESOURCE_MANDI_DAILY=9ef84268-d588-465a-a308-a864a43d0070
DATAGOVIN_RESOURCE_MANDI_VARIETY=35985678-0d79-46b4-9ed6-6f13308a1d24
# Comma-separated resource IDs (MSP is published as several tables)
DATAGOVIN_RESOURCE_MSP=82e89d31-2208-4be0-babd-2286a4d9110b,b45f166a-9a89-492f-a8ed-3cb245850408
# Comma-separated YYYY-YY:resource-id (one export resource per year; no 2020-21 resource is published)
DATAGOVIN_RESOURCE_EXPORT_PRINCIPAL=2014-15:5c9f6e83-cf91-4e8a-84fc-f817febf51c2,2015-16:fb6e967c-102f-40e1-989b-1b60ce55569b,2016-17:c118fab2-1782-450b-9593-14b77985b0c0,2017-18:9b5cc0ee-d4e5-436d-9ffa-13e5c0d26eb9,2018-19:2b07aa13-faea-4ec1-8709-38df9852e6fd,2019-20:36e01bc4-9a07-4d02-9e7b-5b481d13ab24,2021-22:a66f8149-d060-43f9-bc94-e9daeb2c0188,2022-23:d7999d61-6ea9-4455-95b1-ad3b9467a015
DATAGOVIN_RESOURCE_EXPORT_COUNTRYWISE=   # optional; principal-commodity resources already include countries

# AI
AI_GATEWAY_API_KEY=
AI_MODEL_ID=                             # VERIFY DeepSeek V4.1 Flash ID in Gateway
AI_DAILY_TOKEN_CAP=200000
SARVAM_API_KEY=                          # optional
FEATURE_TRANSLATION=false

# Maps
OLA_MAPS_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Security
CRON_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Site
NEXT_PUBLIC_SITE_URL=https://mandiport.in
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Scale controls
